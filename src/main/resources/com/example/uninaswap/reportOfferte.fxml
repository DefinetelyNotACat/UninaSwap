<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.uninaswap.boundary.ReportOfferteBoundary"
            prefHeight="600.0" prefWidth="800.0"
            styleClass="report-root"
            stylesheets="@report.css">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="20" bottom="10"/></padding>
            <Label text="Report Statistico Offerte Inviate" styleClass="report-title"/>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="chartContainer" />
    </center>

    <bottom>
        <VBox spacing="10" styleClass="report-details-container">
            <Label text="Dettagli Economici (Solo Offerte di Vendita Accettate)" styleClass="report-details-title"/>
            <HBox spacing="30" alignment="CENTER">
                <Label fx:id="lblMedia" text="Media: - €" styleClass="lbl-stat-media"/>
                <Label fx:id="lblMin" text="Minimo: - €" styleClass="lbl-stat-min"/>
                <Label fx:id="lblMax" text="Massimo: - €" styleClass="lbl-stat-max"/>
            </HBox>
            <HBox alignment="CENTER">
                <Button text="Chiudi" onAction="#chiudiFinestra" styleClass="button-close"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>