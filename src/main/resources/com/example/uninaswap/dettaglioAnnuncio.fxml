<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.uninaswap.boundary.DettaglioAnnuncioBoundary" stylesheets="@homepage.css, @banners.css, @dettaglio.css" styleClass="detail-root">
    <top>
        <HBox alignment="CENTER" styleClass="navbar-container">
            <fx:include source="navbar.fxml" />
        </HBox>
    </top>
    <center>
        <StackPane>
            <padding><Insets top="30" bottom="30" left="20" right="20"/></padding>
            <HBox alignment="CENTER" spacing="40" maxWidth="1100" styleClass="detail-card">

                <VBox spacing="15" alignment="TOP_CENTER">
                    <VBox alignment="CENTER" styleClass="image-wrapper" minHeight="400" minWidth="400">
                        <ImageView fx:id="immagineAnnuncio" fitWidth="400" fitHeight="400" preserveRatio="true" smooth="true"/>
                    </VBox>

                    <ScrollPane fx:id="scrollMiniature" fitToHeight="true" minHeight="80" prefHeight="80" styleClass="mini-scroll" vbarPolicy="NEVER">
                        <content>
                            <HBox fx:id="containerMiniature" spacing="10" alignment="CENTER_LEFT">
                                <padding><Insets left="5" right="5"/></padding>
                            </HBox>
                        </content>
                    </ScrollPane>
                </VBox>

                <VBox spacing="20" alignment="CENTER_LEFT" prefWidth="480">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="badgeTipo" styleClass="badge-base"/>
                        <Text fx:id="txtSede" styleClass="detail-location"/>
                    </HBox>

                    <Text fx:id="txtTitoloDescrizione" styleClass="detail-title" wrappingWidth="450"/>

                    <VBox spacing="15" styleClass="info-section">
                        <VBox spacing="5">
                            <Text text="VALORE / CERCO" styleClass="info-label"/>
                            <Text fx:id="txtDettagliSpecifici" styleClass="info-value"/>
                            <Text fx:id="txtPrezzoMinimo" styleClass="label-alert"/>
                        </VBox>
                        <VBox spacing="5">
                            <Text text="CONDIZIONI" styleClass="info-label"/>
                            <Text fx:id="txtCondizioni" styleClass="label-dark-bold"/>
                        </VBox>
                        <VBox spacing="10">
                            <Text text="VENDITORE" styleClass="info-label"/>
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <ImageView fx:id="immagineProfiloVenditore" fitWidth="50" fitHeight="50" smooth="true"/>
                                <VBox spacing="2">
                                    <Text fx:id="txtVenditore" styleClass="label-dark-bold"/>
                                    <Text fx:id="txtEmailVenditore" styleClass="label-italic-small"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <HBox spacing="15" alignment="BOTTOM_RIGHT" VBox.vgrow="ALWAYS">
                        <Button text="Torna Indietro" onAction="#tornaIndietro" styleClass="btn-back"/>
                        <Button fx:id="btnFaiOfferta" text="Fai un'Offerta" onAction="#apriSchermataOfferta" styleClass="button-primary"/>
                    </HBox>
                </VBox>
            </HBox>
        </StackPane>
    </center>
</BorderPane>